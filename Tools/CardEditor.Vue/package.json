{
  "name": "legends-of-furry-card-editor",
  "version": "1.0.0",
  "description": "Legends of Furry 卡牌内容数据库维护工具",
  "author": "Legends of Furry Team",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"pnpm dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "vitest run",
    "package:win": "pnpm build && electron-builder --win dir"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "blockly": "^13.2.1",
    "element-plus": "^2.11.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.legendsoffurry.cardeditor",
    "productName": "LOF.CardEditor",
    "directories": {
      "output": "release-v2"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  }
}
